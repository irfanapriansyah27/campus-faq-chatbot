# Runtime lokal
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
CHATBOT_API_URL=http://localhost:3000

# Akses admin lokal; gunakan nilai acak minimal 20 karakter
ADMIN_INGEST_KEY=replace-with-local-random-value
ADMIN_APP_ORIGIN=http://localhost:3000
ADMIN_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
ADMIN_LOGIN_RATE_LIMIT=10

# Supabase non-Production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Provider AI
GEMINI_API_KEY=replace-with-server-only-gemini-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-server-only-api-token
CLOUDFLARE_LLM_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Retrieval dan fallback
MATCH_THRESHOLD=0.65
MATCH_COUNT=3
MAX_CHAT_HISTORY=6
CS_FALLBACK_MESSAGE=Informasi belum tersedia dalam FAQ kampus. Silakan hubungi petugas layanan kampus.
